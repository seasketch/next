{
  "name": "@seasketch/raster-array",
  "version": "0.1.0",
  "description": "Encode multi-band GeoTIFF/NetCDF as Mapbox Raster Tiles (MRT) for raster-array sources. Proof of concept; not wired into SeaSketch ingest yet.",
  "author": "Chad Burt <chad@underbluewaters.net>",
  "homepage": "https://github.com/seasketch/next#readme",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "raster-array": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasketch/next.git"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "encode": "npx --yes tsx@4.19.3 src/cli.ts encode",
    "inspect": "npx --yes tsx@4.19.3 src/cli.ts inspect",
    "fixtures": "npx --yes tsx@4.19.3 scripts/build-fixtures.ts",
    "gmw:global": "npx --yes tsx@4.19.3 scripts/encode-gmw-global.ts",
    "demo": "npx --yes tsx@4.19.3 demos/server.ts"
  },
  "bugs": {
    "url": "https://github.com/seasketch/next/issues"
  },
  "devDependencies": {
    "@types/node": "^18.11.4",
    "typescript": "5.5.3",
    "vitest": "^1.6.1"
  }
}
