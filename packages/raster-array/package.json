{
  "name": "@seasketch/raster-array",
  "version": "0.1.0",
  "description": "Encode multi-band GeoTIFF/NetCDF as Mapbox Raster Tiles (MRT) and pack them into PMTiles.",
  "author": "Chad Burt <chad@underbluewaters.net>",
  "homepage": "https://github.com/seasketch/next#readme",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "raster-array": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasketch/next.git"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "encode": "tsx src/cli.ts encode",
    "inspect": "tsx src/cli.ts inspect",
    "pack": "tsx src/cli.ts pack"
  },
  "bugs": {
    "url": "https://github.com/seasketch/next/issues"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  }
}
