# Copy to .env. Under `npm run dev` the storage values (R2_ENDPOINT, the local
# credentials, R2_TILES_BUCKET, TILES_REMOTE, UPLOADS_BASE_URL) and PORT are
# injected to point at the local stack while it runs, so they can stay empty
# here. Fill them in only to run this handler against production storage, and
# never in CI.
PGHOST=localhost
PGPORT=54321
PGUSER=postgres
PGDATABASE=seasketch
PGPASSWORD=password
PGREGION=us-west-2

BUCKET=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local defaults, as `npm run dev` injects them. The production values are
# the R2 endpoint, real keys, ssn-tiles, and https://uploads.seasketch.org.
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local-r2-secret
R2_ENDPOINT=http://localhost:8333/cdn-cgi/local/r2/s3
R2_TILES_BUCKET=ssn-tiles-local
TILES_REMOTE=r2://ssn-tiles-local
UPLOADS_BASE_URL=http://localhost:8788

PORT=3006
