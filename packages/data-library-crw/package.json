{
  "name": "@seasketch/data-library-crw",
  "version": "0.1.0",
  "private": true,
  "description": "Workstation job: NOAA Coral Reef Watch annual composites and daily DHW as MRT PMTiles for the Data Library.",
  "author": "Chad Burt <chad@underbluewaters.net>",
  "license": "BSD-3-Clause",
  "bin": {
    "data-library-crw": "src/cli.ts"
  },
  "scripts": {
    "build": "npx --yes tsx@4.19.3 src/cli.ts build",
    "download": "npx --yes tsx@4.19.3 src/cli.ts download",
    "stack": "npx --yes tsx@4.19.3 src/cli.ts stack",
    "encode": "npx --yes tsx@4.19.3 src/cli.ts encode",
    "pack": "npx --yes tsx@4.19.3 src/cli.ts pack",
    "runbook": "npx --yes tsx@4.19.3 src/cli.ts runbook",
    "upload": "npx --yes tsx@4.19.3 src/cli.ts upload",
    "verify": "npx --yes tsx@4.19.3 src/cli.ts verify",
    "demo": "npx --yes tsx@4.19.3 demo/server.ts",
    "test": "npx --yes tsx@4.19.3 --test src/products.test.ts src/runbook.test.ts src/download.test.ts src/occupancy.test.ts"
  },
  "dependencies": {
    "@seasketch/raster-array": "file:../raster-array",
    "tsx": "4.19.3"
  },
  "devDependencies": {
    "@types/node": "^18.11.4",
    "typescript": "5.5.3"
  }
}
