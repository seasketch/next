{
  "name": "map-screenshotter",
  "version": "2.0.0",
  "description": "Cloudflare Worker that captures images of SeaSketch maps",
  "author": "Chad Burt <chad@underbluewaters.net>",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port ${SCREENSHOTTER_DEV_PORT:-8791} --var SCREENSHOTTER_TOKEN:${SCREENSHOTTER_DEV_TOKEN:-local-dev-screenshotter} --var SCREENSHOTTER_ALLOW_LOCALHOST:true --no-show-interactive-dev-session",
    "deploy": "wrangler deploy",
    "test": "node --test src/validate.test.js",
    "test:integration": "node --test --test-timeout 180000 src/dev.integration.test.js"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.46.0"
  }
}
