/**
 * Workers Static Assets hosting for the SeaSketch React client.
 *
 * We intentionally do NOT use assets.not_found_handling = "single-page-application".
 * That mode serves index.html for non-asset navigations, but also for requests
 * that omit Sec-Fetch-Mode — and Cloudflare's cache does not Vary on that header.
 * Combined with /static/* immutable _headers, a single no-header probe can poison
 * a hashed JS URL with HTML (the ChunkLoadError we saw in production).
 *
 * Instead: missing assets invoke the Worker, which SPA-falls-back for non-static
 * paths (including dotted project slugs) and returns a real no-store 404 for
 * known static-file extensions that are missing.
 *
 * html_handling: "none" keeps /screenshot.html (and similar) on their literal
 * paths so _headers rules and Puppeteer URLs keep working without a 307 rewrite.
 */
{
  "name": "seasketch-client",
  "compatibility_date": "2026-08-07",
  "main": "./cloudflare/worker.js",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "html_handling": "none",
    // Worker must run first for all requests. Otherwise navigations
    // (Sec-Fetch-Mode: navigate) skip the script and miss SPA fallback.
    "run_worker_first": true
  },
  "vars": {
    "SPRITES_BASE_URL": "https://seasketchpublicuploads-publicuploads056688dd-1evw01vk0kf8z.s3.us-west-2.amazonaws.com/sprites/"
  }
}
