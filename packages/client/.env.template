# SPA client id and domain from your tenant. See AUTH0.md.
# The audience must match the API's JWT_AUD. The value below is seasketch.org production.
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_DOMAIN=
REACT_APP_AUTH0_SCOPE="openid profile email offline_access"
REACT_APP_AUTH0_AUDIENCE=https://api.seasketch.org
REACT_APP_GRAPHQL_ENDPOINT=http://localhost:3857/graphql
# Shared development token. Copy from a teammate. The map stays blank without it.
REACT_APP_MAPBOX_ACCESS_TOKEN=
# Leave unset unless you are using that feature.
REACT_APP_CLOUDFRONT_DOCS_DISTRO=
REACT_APP_CLOUDFLARE_IMAGES_ENDPOINT=
REACT_APP_ARCGIS_DEVELOPER_API_KEY=
# Required outside production. Never "prod". Use the same value as TILES_ACL_NAMESPACE.
REACT_APP_TILES_ACL_NAMESPACE=
SKIP_PREFLIGHT_CHECK=true
