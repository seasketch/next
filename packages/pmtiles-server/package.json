{
  "name": "overlay-data-server",
  "version": "0.0.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "hyparquet-writer": "^0.16.9",
    "typescript": "5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "private": true,
  "scripts": {
    "start": "node bin/dev.mjs tiles",
    "dev": "node bin/dev.mjs tiles",
    "deploy": "wrangler deploy -c wrangler.data-tables.toml && wrangler deploy",
    "deploy:query": "wrangler deploy -c wrangler.data-tables.toml",
    "deploy:gateway": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "dev:tiles": "node bin/dev.mjs tiles",
    "dev:uploads": "node bin/dev.mjs uploads"
  },
  "dependencies": {
    "@seasketch/geostats-types": "^1.0.0",
    "flatbuffers": "^25.9.23",
    "flatgeobuf": "^4.4.0",
    "hyparquet": "^1.26.2",
    "jose": "^5.10.0",
    "minisearch": "^7.2.0",
    "pmtiles": "^4.4.1"
  }
}
