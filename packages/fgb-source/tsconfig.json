{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    // tsc emits the declarations so project references can build this
    // package. tsup emits dist/index.js: flatgeobuf 3.x is ESM-only and the
    // CommonJS consumers (Jest, webpack 4) need it bundled in.
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts", "dist"]
}
