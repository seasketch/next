      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 1
          },
          "content": [
            {
              "text": "Single-sector survey example",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "This Demo Palawan survey is sample data for testing a spatial question that has one sector. The first visit opens the map so you can draw an area. Returning to the question shows the sector list and how many areas were drawn. It is not a live planning survey.",
              "type": "text"
            }
          ]
        }
      ]
    },
    "componentSettings": {
      "beginButtonText": "Begin"
    }
  },
  "spatial": {
    "exportId": "select_areas_to_identify",
    "isRequired": true,
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "question",
          "content": [
            {
              "text": "Select Areas to Identify",
              "type": "text"
            }
          ]
        }
      ]
    },
    "componentSettings": {
      "beginBody": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 1
            },
            "content": [
              {
                "text": "Where should coral recovery activities occur?",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Use the map to indicate the most important areas for coral recovery activities. You can draw multiple areas.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Click on the inset map on the top right to see additional data layers and reference the legend below.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": []
          }
        ]
      },
      "sectorOptions": [
        {
          "label": "Coral Recovery Priority Areas",
          "value": "coral",
          "description": ""
        }
      ],
      "listShapesBody": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Add as many shapes as necessary to represent valued areas, then adjust their relative priority below.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "These scores will be summed among all survey responses to create a heatmap of valued areas.",
                "type": "text"
              }
            ]
          }
        ]
      },
      "startingBounds": [
        115.72850203618498,
        7.163430084953305,
        121.36608618505284,
        11.649742031156578
      ]
    }
