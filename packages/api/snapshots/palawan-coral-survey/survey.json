    {
      "typeId": "Statement",
      "exportId": "definitionsclimate_andor_anthrop",
      "isRequired": false,
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "text": "Definitions",
                "type": "text"
              }
            ]
          },
          {
            "type": "bullet_list",
            "content": [
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Climate and/or anthropogenic refugia: Remote areas far from human influence, areas with environmental conditions naturally conducive to coral recovery",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "ESA / IUCN-listed coral species presence: ESA/IUCN corals are present",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Fisheries / food security dependence: Important fisheries habitat",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Ecosystem and/or reef connectivity importance: Important role for ocean currents, larval dispersal, and animal migrations in linking coral reefs with each other and with adjacent habitats like mangroves and seagrasses",
                        "type": "text"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "componentSettings": {}
    },
