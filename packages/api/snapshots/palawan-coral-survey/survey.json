    {
      "typeId": "Statement",
      "exportId": "definitionsenvironmental_interve",
      "isRequired": false,
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 1
            }
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "text": "Definitions",
                "type": "text"
              }
            ]
          },
          {
            "type": "bullet_list",
            "content": [
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Environmental intervention: Environmental intervention to reduce exposure to thermal stress, solar radiation, and/or ocean acidification",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Biological/ecological intervention: Biological/ecological intervention to mitigate threats, reduce sensitivity and increase resilience to threats (e.g. coral disease mitigation/assessment, coral propagation and outplanting, invasive species/predator control)",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Research: Research to increase understanding of coral taxonomy, biology, ecology, and threat responses",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Fisheries management: (e.g. assessment and minimization of impacts of unsustainable fishing)",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Monitoring, assessment, and surveys: Monitoring, assessment, and surveys to increase knowledge of coral status and trends",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "list_item",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Outreach, education, and capacity-building: Outreach, education, and capacity-building to empower human action",
                        "type": "text"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
