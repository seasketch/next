{
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "target": "ES2019",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // Every workspace package this package imports. `tsc -b` builds them first.
  "references": [
    { "path": "../geostats-types" },
    { "path": "../gl-style-builder" },
    { "path": "../map-tile-cache-calculator" },
    { "path": "../mapbox-gl-esri-sources" },
    { "path": "../metadata-parser" },
    { "path": "../fgb-source" },
    { "path": "../overlay-engine" },
    { "path": "../overlay-worker" },
    { "path": "../spatial-uploads-handler" },
    { "path": "../vector-data-source" },
    { "path": "../ai-data-analyst" }
  ],
  "include": ["src/**/*", "tasks/**/*", "process-env.d.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "dist"]
}
