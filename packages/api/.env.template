# Data-path storage and processors. Leave these unset for local development:
# `npm run dev` starts the local services (packages/local-r2 on 8333, the two
# pmtiles-server sessions on 8787 and 8788, the handler containers, ElasticMQ)
# and points the API at them. Set a production value here to use the deployed
# service instead; `npm run dev` then leaves that local service stopped. The
# CI configuration check refuses the seasketch.org values.
# See design-docs/dev-environment/local-data-services.md.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_TILES_BUCKET=
# SPATIAL_UPLOADS_BUCKET=
# TILES_REMOTE=
# UPLOADS_BASE_URL=
# TILES_BASE_URL=
# SPATIAL_UPLOADS_LAMBDA_ARN=
# SUBDIVISION_WORKER_LAMBDA_ARN=
# DATA_TABLES_HANDLER_LAMBDA_ARN=
# OVERLAY_ENGINE_WORKER_SQS_QUEUE_URL=
# Test-mode login for automated journeys. Signs tokens with this API's keys
# for e2e| users only. Requires NODE_ENV development or test and a passphrase
# of at least 32 characters. The smoke suite's value is committed in
# packages/e2e/e2e.env. Leave unset for normal development.
# E2E_TEST_MODE=true
# E2E_TEST_PASSPHRASE=
# Golden snapshot publish. Defaults to the tiles bucket (uploads.seasketch.org)
# and prefix golden-snapshot. Fetching the snapshot does not use these.
# SNAPSHOT_R2_BUCKET=
# SNAPSHOT_R2_PREFIX=golden-snapshot
# SNAPSHOT_R2_ENDPOINT=
# SNAPSHOT_R2_ACCESS_KEY_ID=
# SNAPSHOT_R2_SECRET_ACCESS_KEY=
# Required outside production. Never "prod". Change this if you share the tiles bucket.
TILES_ACL_NAMESPACE=local
# Map bookmark screenshots. `npm run dev` overrides these with the local
# worker at http://127.0.0.1:8791. Set them to call a deployed worker when
# the API is started on its own. See packages/map-screenshotter/README.md.
# SCREENSHOTTER_URL=
# SCREENSHOTTER_TOKEN=
POEDITOR_API_TOKEN=
POEDITOR_PROJECT=
