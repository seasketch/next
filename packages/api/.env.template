# for e2e| users only. Requires NODE_ENV development or test and a passphrase
# of at least 32 characters. The smoke suite's value is committed in
# packages/e2e/e2e.env. Leave unset for normal development.
# E2E_TEST_MODE=true
# E2E_TEST_PASSPHRASE=
