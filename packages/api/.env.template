DATABASE_URL=postgres://graphile:password@localhost:54321/seasketch
ADMIN_DATABASE_URL=postgres://postgres:password@localhost:54321/seasketch
# seasketch.org production tenant. Any other install replaces these. See AUTH0.md.
# packages/api/env-manifest.json records these values and does not refuse them yet.
JWKS_URI=https://seasketch.auth0.com/.well-known/jwks.json
JWT_AUD=https://api.seasketch.org
JWT_ISS=https://seasketch.auth0.com/
# Management application, not the SPA. The API starts without them. See AUTH0.md.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
PUBLIC_S3_BUCKET=seasketch-next-public-uploads
PUBLIC_UPLOADS_DOMAIN=d17krkm4g5m2af.cloudfront.net
SES_EMAIL_SOURCE='"SeaSketch" <do-not-reply@seasketch.org>'
GRAPHILE_WORKER_CONCURRENCY=5
# Leave unset unless you are using that feature. An unset integration stays unavailable.
TILE_PACKAGES_BUCKET=
# Shared development token. Copy from a teammate. The API starts without it.
MAPBOX_ACCESS_TOKEN=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
R2_FILE_UPLOADS_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Test-mode login for automated journeys. Signs tokens with this API's keys
# for e2e| users only. Requires NODE_ENV development or test and a passphrase
# of at least 32 characters. The smoke suite's value is committed in
# packages/e2e/e2e.env. Leave unset for normal development.
# E2E_TEST_MODE=true
# E2E_TEST_PASSPHRASE=
# Golden snapshot publish. Defaults to the tiles bucket (uploads.seasketch.org)
# and prefix golden-snapshot. Fetching the snapshot does not use these.
# SNAPSHOT_R2_BUCKET=
# SNAPSHOT_R2_PREFIX=golden-snapshot
# SNAPSHOT_R2_ENDPOINT=
# SNAPSHOT_R2_ACCESS_KEY_ID=
# SNAPSHOT_R2_SECRET_ACCESS_KEY=
# Required outside production. Never "prod". Example: dev-yourname
TILES_ACL_NAMESPACE=
SCREENSHOTTER_FUNCTION_ARN=
POEDITOR_API_TOKEN=
POEDITOR_PROJECT=
REDIS_PASSWORD=ucsb
CLIENT_DOMAIN=localhost:3000
# Local data table upload processing (npm run dev listens on port 3006)
DATA_TABLES_LAMBDA_DEV_HANDLER=http://localhost:3006
