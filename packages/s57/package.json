{
  "name": "@seasketch/s57",
  "version": "1.0.0",
  "private": true,
  "description": "Turn unencrypted S-57 ENC cells into vector tiles and an S-52 day chart style",
  "license": "BSD-3-Clause",
  "main": "./dist/style.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test test/*.test.ts && python3 test/peel.test.py",
    "fetch": "tsx scripts/fetch-chart.ts",
    "chart": "tsx scripts/build-chart.ts",
    "demo": "node demo/serve.mjs"
  }
}
