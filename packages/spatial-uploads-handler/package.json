{
  "name": "spatial-uploads-handler",
  "version": "1.0.0",
  "description": "Processes spatial data uploads. May tile them using tippecanoe or gdal, or convert to geojson if small",
  "author": "Chad Burt <chad@underbluewaters.net>",
  "homepage": "https://github.com/seasketch/next#readme",
  "license": "BSD-3-Clause",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seasketch/next.git"
  },
  "scripts": {
    "start": "cd ../.. && docker compose --profile data up spatial-uploads",
    "dev": "tsx watch server.ts",
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "build:container": "node ../../scripts/build-images.mjs spatial-uploads-handler",
    "runtime-image": "node scripts/runtime-image.mjs",
    "runtime-image:pin": "node scripts/runtime-image.mjs --pin",
    "runtime-image:check": "node scripts/runtime-image.mjs --check",
    "runtime-image:build": "docker build --platform linux/amd64 -f Dockerfile.runtime -t \"$(node scripts/runtime-image.mjs)\" .",
    "test": "jest",
    "deploy:pre": "npm run build",
    "geostats": "tsx bin/geostats.ts"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist/"
    ]
  },
  "bugs": {
    "url": "https://github.com/seasketch/next/issues"
  },
  "dependencies": {
    "@aws-sdk/lib-storage": "^3.1151.0",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-typescript": "^7.24.1",
    "@mapbox/mbtiles": "^0.12.1",
    "@seasketch/geostats-types": "^1.0.0",
    "@seasketch/metadata-parser": "^1.0.0",
    "@slack/web-api": "^7.8.0",
    "@turf/bbox": "^7.4.0",
    "@types/bytes": "^3.1.1",
    "@types/geojson": "^7946.0.10",
    "@types/jest": "^29.5.12",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/tmp": "^0.2.3",
    "@types/xml2js": "^0.4.14",
    "ai-data-analyst": "^1.0.0",
    "bytes": "^3.1.2",
    "geostats": "^2.1.0",
    "lodash.debounce": "^4.0.8",
    "prosemirror-markdown": "^1.13.0",
    "sanitize-filename": "^1.6.3",
    "simple-statistics": "^7.8.3",
    "tmp": "^0.2.1",
    "typescript": "5.8.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "aws-sdk": "^2.1234.0",
    "dotenv": "^17.2.1",
    "esno": "^0.16.3",
    "gdal-async": "^3.11.3",
    "jest": "^29.7.0",
    "pg": "^8.23.1",
    "sharp": "^0.33.5"
  }
}
