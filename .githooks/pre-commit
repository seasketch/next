#!/usr/bin/env bash
# Refuse commits that add or edit packages/api/migrations/committed.
# Installed by scripts/install-git-hooks.mjs (npm install sets core.hooksPath).
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  echo "migration commit guard skipped: node is not on PATH" >&2
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec node "$ROOT/scripts/migration-commit-guard.mjs" pre-commit
