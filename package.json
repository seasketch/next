{
  "name": "root",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "setup": "bash packages/api/scripts/setup.sh",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && npm run build:bundles",
    "build:api": "tsc -b packages/api && npm run build:bundles",
    "build:client-libs": "tsc -b packages/geostats-types packages/map-tile-cache-calculator packages/mapbox-gl-esri-sources packages/overlay-engine && npm run build:bundles",
    "build:bundles": "npm run build --workspace=fgb-source --silent && npm run build:worker --workspace=overlay-engine --silent",
    "build:images": "node scripts/build-images.mjs",
    "test": "node scripts/test-workspaces.mjs",
    "dev:db": "docker compose up -d --wait",
    "logs": "node scripts/logs.mjs",
    "status": "node scripts/status.mjs",
    "snapshot:create": "bash packages/api/scripts/snapshot-create.sh",
    "snapshot:publish": "node packages/api/scripts/snapshot-r2.js push",
    "probe:production": "node packages/production-probe/src/cli.js",
    "e2e": "node scripts/e2e.mjs",
    "e2e:headed": "node scripts/e2e.mjs --headed",
    "e2e:ui": "node scripts/e2e.mjs --ui"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250607.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@types/express": "4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^4.17.0",
    "@typescript-eslint/parser": "^4.17.0",
    "@vitest/coverage-v8": "^3.2.2",
    "concurrently": "9.2.5",
    "eslint": "^7.21.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "lru-cache": "^11.2.4",
    "rotating-file-stream": "3.2.10",
    "tsx": "^4.19.3",
    "typescript": "5.8.3",
    "wait-on": "9.5.1"
  },
  "graphql-inspector": {
    "branch": "master",
    "schema": "packages/api/generated-schema.gql"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "form-data": "^4.0.0",
    "graphql": "15.10.3",
    "node-fetch": "^2.6.7"
  },
  "overrides": {
    "@radix-ui/react-accordion": "1.1.2",
    "@radix-ui/react-context-menu": "2.1.5",
    "@radix-ui/react-dropdown-menu": "2.0.6",
    "@radix-ui/react-menubar": "1.0.4",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.0.5",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slider": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "@types/bytes": "3.1.2",
    "@types/mapbox-gl": "3.1.0",
    "mapbox-gl": "3.4.0"
  }
}
