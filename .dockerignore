# Context root for SpatialUploadsHandler and DataTablesHandler
# (packages/infra/lib/*LambdaStack.ts passes the repo root to fromImageAsset).
# Those Dockerfiles COPY only the workspaces they build, so this list keeps
# the staged context small and keeps local-only files out of the images.
.git
**/node_modules
# CDK writes the cloud assembly here, inside the repo-root Docker context.
# Leaving it out of the ignore list makes each synth hash the previous staged
# copy of the repo, including that copy's own cdk.out.
**/cdk.out
**/.logs
**/.tsbuildinfo
**/dist
# compose.yaml watches this directory into the running spatial-uploads
# container, and Compose Watch applies this file to the watched paths. The
# builder stage recompiles it, so a stale host copy never reaches the image.
!packages/spatial-uploads-handler/dist
**/coverage
**/__tests__
**/*.test.ts
**/.env
**/.env.*
**/.wrangler
packages/client/build
packages/data-tables-handler/tmp
packages/e2e/test-results
packages/e2e/playwright-report
packages/api/snapshots
# Local data caches. Git ignores them, but CDK still stages the repo root
# into cdk.out before Docker runs, and these Dockerfiles never COPY them.
packages/data-library-crw/work
packages/data-library-crw/**/*.nc
packages/data-library-crw/**/*.tif
packages/data-library-crw/**/*.vrt
packages/data-library-crw/**/*.pmtiles
packages/h3-land/data
# Local object storage and wrangler state. Large, and never part of an image.
.data
