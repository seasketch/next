{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: stack",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "seasketch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Container",
          "endsPattern": "Healthy"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: core only",
      "type": "shell",
      "command": "npm run dev -- --profile core",
      "isBackground": true,
      "problemMatcher": {
        "owner": "seasketch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Container",
          "endsPattern": "Healthy"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: client log",
      "type": "shell",
      "command": "npm run logs -- client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "seasketch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: db watch log",
      "type": "shell",
      "command": "npm run logs -- db-watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "seasketch",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: logs",
      "dependsOn": ["Dev: client log", "Dev: db watch log"],
      "problemMatcher": []
    },
    {
      "label": "Dev: core",
      "dependsOrder": "sequence",
      "dependsOn": ["Dev: stack", "Dev: logs"],
      "problemMatcher": []
    }
  ]
}
